{
  "$description": "语义颜色。组件只引用这一层。值可以是 {色板引用}，或 {color, alpha}。light/dark 必填；light-hc/dark-hc 只写与普通模式不同的项。",
  "bg.canvas": {
    "light": "{stone.100}",
    "dark": "{stone.950}",
    "$description": "页面底，也是“砖缝”的颜色"
  },
  "bg.surface": {
    "light": "{stone.25}",
    "dark": "{stone.900}",
    "$description": "卡片、砖面"
  },
  "bg.elevated": {
    "light": "{white}",
    "dark": "{stone.850}",
    "$description": "浮层"
  },
  "bg.elevated-2": {
    "light": "{white}",
    "dark": "{stone.800}",
    "$description": "浮层上的浮层"
  },
  "bg.inverse": {
    "light": "{ink}",
    "dark": "{stone.975}",
    "$description": "反色砖：提示消息、工具提示"
  },
  "bg.scrim": {
    "light": {
      "color": "{ink}",
      "alpha": 0.36
    },
    "dark": {
      "color": "{black}",
      "alpha": 0.6
    }
  },
