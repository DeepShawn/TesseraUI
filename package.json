{
  "name": "tesseraui",
  "version": "0.3.2",
  "description": "TesseraUI：面向 Apple、Android、Windows 与 Web 的跨平台 UI 设计标准库",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-icons.mjs",
    "check:contrast": "node scripts/check-contrast.mjs --report docs/contrast-report.md",
    "check:icons": "node scripts/check-icons.mjs",
    "test": "npm run build && npm run check:contrast && npm run check:icons && node --test tests/*.test.mjs",
    "demo": "npm run build && npx --yes http-server -c-1 -p 5173 .",
    "test:e2e": "node tests/e2e/components.e2e.cjs",
    "test:inputs": "node tests/e2e/inputs.e2e.cjs",
    "test:a11y": "node tests/e2e/a11y.e2e.cjs",
    "test:visual": "node tests/e2e/visual.e2e.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DeepShawn/TesseraUI.git"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "ui",
    "swiftui",
    "jetpack-compose",
    "winui",
    "css"
  ]
}
