<!-- v0.6 数据展示：系统控件的 TesseraUI 样式。合并在 TesseraForms.xaml 之后（外观字典之前）。颜色由 TesseraTheme.xaml 的轻量样式提供。 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 树：每行至少 44 高（触控目标）；圆角跟随列表行（拼贴 / 圆融 / 流韵各自的值） -->
    <Style x:Key="TesseraTreeViewItemStyle" TargetType="TreeViewItem">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="{ThemeResource TesseraListItemRadius}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- 工具提示：一块小反色砖 -->
    <Style x:Key="TesseraToolTipStyle" TargetType="ToolTip">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MaxWidth" Value="260" />
    </Style>

    <!-- 气泡卡片：Flyout 的面板，圆角 18、内边距 20、最宽 340 -->
    <Style x:Key="TesseraFlyoutPresenterStyle" TargetType="FlyoutPresenter">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="MaxWidth" Value="340" />
    </Style>

    <!-- 线形进度：8 高的凹槽 -->
    <Style x:Key="TesseraProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
</ResourceDictionary>
