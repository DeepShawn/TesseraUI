    <!-- 字体：英文 Plus Jakarta Sans，中文Microsoft YaHei UI，回退 Segoe UI Variable -->
    <FontFamily x:Key="TesseraFontFamily">Plus Jakarta Sans, Microsoft YaHei UI, Segoe UI Variable</FontFamily>
    <FontFamily x:Key="TesseraMonoFontFamily">JetBrains Mono, SF Mono, Cascadia Code, Menlo, Consolas</FontFamily>
    <Style x:Key="TesseraDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="LineHeight" Value="48" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
