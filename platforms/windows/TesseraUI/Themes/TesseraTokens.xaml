    <!-- 字体：英文 Instrument Sans，中文Microsoft YaHei UI，回退 Segoe UI Variable -->
    <FontFamily x:Key="TesseraFontFamily">Instrument Sans, Microsoft YaHei UI, Segoe UI Variable</FontFamily>
    <!-- 标题：软衬线 Fraunces + 思源宋体（需随应用打包；未打包时回退到微软雅黑） -->
    <FontFamily x:Key="TesseraDisplayFontFamily">Fraunces, Source Han Serif SC, Microsoft YaHei UI, Segoe UI Variable</FontFamily>
    <FontFamily x:Key="TesseraMonoFontFamily">JetBrains Mono, SF Mono, Cascadia Code, Menlo, Consolas</FontFamily>
    <Style x:Key="TesseraDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TesseraDisplayFontFamily}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="LineHeight" Value="52" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="SemiBold" />
