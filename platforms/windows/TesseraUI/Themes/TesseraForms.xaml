<!-- v0.5 表单与输入：系统控件的 TesseraUI 样式。合并在 TesseraControls.xaml 之后（外观字典之前）。颜色由 TesseraTheme.xaml 的轻量样式提供。 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tessera="using:TesseraUI">

    <!-- 悬浮按钮：56 高的大釉面砖（拼贴 20 圆角，圆融为胶囊） -->
    <Style x:Key="TesseraFabButtonStyle" TargetType="Button" BasedOn="{StaticResource TesseraPrimaryButtonStyle}">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <!-- 链接：釉色文字，悬停浅底；触摸区域不小于 44 高 -->
    <Style x:Key="TesseraLinkButtonStyle" TargetType="HyperlinkButton">
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- 多行文本：随内容长高；字数统计请在 TextCompositionEnded 后再更新（见 README） -->
    <Style x:Key="TesseraTextAreaStyle" TargetType="TextBox" BasedOn="{StaticResource TesseraTextBoxStyle}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="CornerRadius" Value="{ThemeResource TesseraRadiusLg}" />
    </Style>

    <!-- 滑块：凹槽轨道、釉色填充（颜色来自 TesseraTheme.xaml） -->
    <Style x:Key="TesseraSliderStyle" TargetType="Slider">
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <!-- 日历：砖面面板，选中日期是深色描边砖 -->
    <Style x:Key="TesseraCalendarViewStyle" TargetType="CalendarView">
        <Setter Property="CornerRadius" Value="{ThemeResource TesseraRadiusLg}" />
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
        <Setter Property="FirstDayOfWeek" Value="Monday" />
        <Setter Property="BorderThickness" Value="{ThemeResource TesseraSurfaceBorderThickness}" />
    </Style>

    <!-- 日期 / 时间选择：输入框外观的触发器，点开是系统滚轮（颜色来自 TesseraTheme.xaml） -->
    <Style x:Key="TesseraCalendarDatePickerStyle" TargetType="CalendarDatePicker">
        <Setter Property="CornerRadius" Value="{ThemeResource TesseraRadiusMd}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FirstDayOfWeek" Value="Monday" />
        <Setter Property="DateFormat" Value="{}{year.full} 年 {month.integer} 月 {day.integer} 日" />
    </Style>
    <Style x:Key="TesseraDatePickerStyle" TargetType="DatePicker">
        <Setter Property="CornerRadius" Value="{ThemeResource TesseraRadiusMd}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="tessera:TesseraTouch.MinTarget" Value="40" />
    </Style>
    <Style x:Key="TesseraTimePickerStyle" TargetType="TimePicker">
        <Setter Property="CornerRadius" Value="{ThemeResource TesseraRadiusMd}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="ClockIdentifier" Value="24HourClock" />
        <!-- 模板里的按钮只有 32 高，撑到 40 -->
        <Setter Property="tessera:TesseraTouch.MinTarget" Value="40" />
    </Style>

    <!-- 颜色选择 -->
    <Style x:Key="TesseraColorPickerStyle" TargetType="ColorPicker">
        <Setter Property="CornerRadius" Value="{ThemeResource TesseraRadiusMd}" />
        <Setter Property="IsAlphaEnabled" Value="False" />
        <Setter Property="IsMoreButtonVisible" Value="False" />
        <!-- 与其他端一致：只保留十六进制输入，不显示 RGB 三个通道输入框和颜色模式下拉 -->
        <Setter Property="IsColorChannelTextInputVisible" Value="False" />
        <!-- 亮度滑块、十六进制输入框默认 32 高，撑到 40 -->
        <Setter Property="tessera:TesseraTouch.MinTarget" Value="40" />
    </Style>
</ResourceDictionary>
