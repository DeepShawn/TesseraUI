<!-- TesseraUI v0.3.0 — 由 scripts/build.mjs 从 tokens/*.json 生成，请勿手改。 -->
<!-- 圆融外观：胶囊与大圆角，成组控件合成一整块，没有砖缝和分割线。
     用法：在 App.xaml 中紧跟 TesseraTokens.xaml、TesseraTheme.xaml 之后合并本文件；不合并即为默认的“拼贴”外观。
     WinUI 会把超过半高的圆角自动收成半圆，所以 9999 就是胶囊。 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 成组控件内侧不留圆角、不留缝，合成一整块 -->
    <CornerRadius x:Key="TesseraRadiusGrout">0</CornerRadius>
    <x:Double x:Key="TesseraTileGrout">0</x:Double>
    <!-- 去掉砖厚 -->
    <x:Double x:Key="TesseraTileEdge">0</x:Double>
    <Thickness x:Key="TesseraTileEdgeThickness">0</Thickness>

    <CornerRadius x:Key="TesseraRadiusSm">9999</CornerRadius>
    <CornerRadius x:Key="TesseraRadiusMd">20</CornerRadius>
    <CornerRadius x:Key="TesseraRadiusLg">24</CornerRadius>
    <CornerRadius x:Key="TesseraRadiusXl">28</CornerRadius>
    <CornerRadius x:Key="TesseraRadius2xl">36</CornerRadius>
    <CornerRadius x:Key="TesseraRoundRow">22</CornerRadius>
    <CornerRadius x:Key="TesseraRoundPill">9999</CornerRadius>
    <x:Double x:Key="TesseraRoundGap">8</x:Double>
    <x:Double x:Key="TesseraRoundPressScale">0.97</x:Double>
    <!-- 标记：自定义控件据此切换到圆融外观 -->
    <x:String x:Key="TesseraShape">round</x:String>

    <!-- 系统控件 -->
    <CornerRadius x:Key="ControlCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">24</CornerRadius>
</ResourceDictionary>
