<!-- TesseraUI 控件样式（WinUI 3）。依赖 TesseraTokens.xaml；建议同时合并 TesseraTheme.xaml（系统控件的轻量样式）。 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 图标按钮 IconButton ================= -->
    <Style x:Key="TesseraIconButtonStyle" TargetType="Button" BasedOn="{StaticResource TesseraTextButtonStyle}">
        <Setter Property="Width" Value="{StaticResource TesseraSizeMd}" />
        <Setter Property="Height" Value="{StaticResource TesseraSizeMd}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource TesseraTextPrimaryBrush}" />
    </Style>
    <Style x:Key="TesseraFilledIconButtonStyle" TargetType="Button" BasedOn="{StaticResource TesseraSecondaryButtonStyle}">
        <Setter Property="Width" Value="{StaticResource TesseraSizeMd}" />
        <Setter Property="Height" Value="{StaticResource TesseraSizeMd}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ================= 文本框 TextField / 搜索框 SearchField：凹槽 ================= -->
    <Style x:Key="TesseraTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="{StaticResource TesseraSizeMd}" />
        <Setter Property="Padding" Value="12,9,12,9" />
        <Setter Property="CornerRadius" Value="{StaticResource TesseraRadiusMd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource TesseraAccentSolidBrush}" />
    </Style>
    <Style x:Key="TesseraPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
        <Setter Property="MinHeight" Value="{StaticResource TesseraSizeMd}" />
        <Setter Property="Padding" Value="12,9,12,9" />
        <Setter Property="CornerRadius" Value="{StaticResource TesseraRadiusMd}" />
    </Style>
    <Style x:Key="TesseraSearchBoxStyle" TargetType="AutoSuggestBox" BasedOn="{StaticResource DefaultAutoSuggestBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource TesseraSizeMd}" />
        <Setter Property="CornerRadius" Value="{StaticResource TesseraRadiusMd}" />
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
    </Style>

    <!-- ================= 下拉选择 Select ================= -->
    <Style x:Key="TesseraComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource TesseraSizeMd}" />
        <Setter Property="CornerRadius" Value="{StaticResource TesseraRadiusMd}" />
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
    </Style>

    <!-- ================= 复选框 / 单选：复选框是 7 圆角的小砖 ================= -->
    <Style x:Key="TesseraCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
        <Setter Property="MinHeight" Value="{StaticResource TesseraSizeTouchMin}" />
    </Style>
    <Style x:Key="TesseraRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
        <Setter Property="MinHeight" Value="{StaticResource TesseraSizeTouchMin}" />
    </Style>

    <!-- ================= 开关 Switch：凹槽轨道 + 方砖滑块；保留 ToggleSwitch 自带的拖动 ================= -->
    <Style x:Key="TesseraToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TesseraTextPrimaryBrush}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource TesseraFocusRingBrush}" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter x:Name="HeaderContentPresenter" Grid.Row="0" Margin="0,0,0,6"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Foreground="{ThemeResource TesseraTextPrimaryBrush}" IsHitTestVisible="False"
                                          Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                        <Grid Grid.Row="1" MinHeight="{StaticResource TesseraSizeTouchMin}" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="SwitchAreaGrid" Grid.ColumnSpan="3" Background="Transparent" Control.IsTemplateFocusTarget="True" />
                            <ContentPresenter x:Name="OffContentPresenter" Grid.Column="2" VerticalAlignment="Center" Opacity="0"
                                              Content="{TemplateBinding OffContent}" ContentTemplate="{TemplateBinding OffContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <ContentPresenter x:Name="OnContentPresenter" Grid.Column="2" VerticalAlignment="Center" Opacity="0"
                                              Content="{TemplateBinding OnContent}" ContentTemplate="{TemplateBinding OnContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <!-- 关闭时的轨道（凹槽） -->
                            <Border x:Name="OuterBorder" Width="52" Height="30" CornerRadius="13" VerticalAlignment="Center"
                                    Background="{ThemeResource TesseraFillControlOffBrush}" BorderBrush="{ThemeResource TesseraBorderFieldBrush}" BorderThickness="1" />
                            <!-- 开启时的轨道 -->
                            <Border x:Name="SwitchKnobBounds" Width="52" Height="30" CornerRadius="13" VerticalAlignment="Center" Opacity="0"
                                    Background="{ThemeResource TesseraAccentControlBrush}" />
                            <!-- 开 / 关标记 -->
                            <Rectangle x:Name="OnMark" Width="1.5" Height="9" Margin="15,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Fill="{ThemeResource TesseraTextOnSolidBrush}" Opacity="0" />
                            <Ellipse x:Name="OffMark" Width="8" Height="8" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Stroke="{ThemeResource TesseraTextTertiaryBrush}" StrokeThickness="1.2" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><TranslateTransform X="33" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- 方砖滑块：24×24，圆角 10 -->
                            <Grid x:Name="SwitchKnob" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="KnobTranslateTransform" />
                                </Grid.RenderTransform>
                                <Border x:Name="SwitchKnobOn" Width="24" Height="24" CornerRadius="10" Background="White" Opacity="0" />
                                <Border x:Name="SwitchKnobOff" Width="24" Height="24" CornerRadius="10" Background="White" />
                            </Grid>
                            <Thumb x:Name="SwitchThumb" AutomationProperties.AccessibilityView="Raw">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Rectangle Fill="Transparent" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <!-- 按住时滑块横向拉宽 -->
                                        <Setter Target="SwitchKnobOn.Width" Value="30" />
                                        <Setter Target="SwitchKnobOff.Width" Value="30" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="SwitchAreaGrid.Opacity" Value="{StaticResource TesseraDisabledOpacity}" />
                                        <Setter Target="OuterBorder.Opacity" Value="{StaticResource TesseraDisabledOpacity}" />
                                        <Setter Target="SwitchKnob.Opacity" Value="{StaticResource TesseraDisabledOpacity}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualStateGroup.Transitions>
                                    <!-- 松手：近似 snappy 弹簧（0.3s，回弹 0.15） -->
                                    <VisualTransition x:Name="DraggingToOnTransition" From="Dragging" To="On" GeneratedDuration="0:0:0.3">
                                        <VisualTransition.GeneratedEasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.25" /></VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition x:Name="DraggingToOffTransition" From="Dragging" To="Off" GeneratedDuration="0:0:0.3">
                                        <VisualTransition.GeneratedEasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.25" /></VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition x:Name="OnToOffTransition" From="On" To="Off" GeneratedDuration="0:0:0.3">
                                        <VisualTransition.GeneratedEasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.25" /></VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition x:Name="OffToOnTransition" From="Off" To="On" GeneratedDuration="0:0:0.3">
                                        <VisualTransition.GeneratedEasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.25" /></VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Dragging" />
                                <VisualState x:Name="Off">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="0" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="On">
                                    <VisualState.Setters>
                                        <Setter Target="SwitchKnobBounds.Opacity" Value="1" />
                                        <Setter Target="OuterBorder.Opacity" Value="0" />
                                        <Setter Target="SwitchKnobOn.Opacity" Value="1" />
                                        <Setter Target="SwitchKnobOff.Opacity" Value="0" />
                                        <Setter Target="OnMark.Opacity" Value="1" />
                                        <Setter Target="OffMark.Opacity" Value="0" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="22" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ContentStates">
                                <VisualState x:Name="OffContent">
                                    <VisualState.Setters><Setter Target="OffContentPresenter.Opacity" Value="1" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="OnContent">
                                    <VisualState.Setters><Setter Target="OnContentPresenter.Opacity" Value="1" /></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 菜单 Menu ================= -->
    <Style x:Key="TesseraMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="{StaticResource TesseraRadiusLg}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{ThemeResource TesseraBgElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TesseraBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="220" />
    </Style>
    <Style x:Key="TesseraMenuFlyoutItemStyle" TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
    </Style>

    <!-- ================= 对话框 Dialog：按钮是一组拼贴砖 ================= -->
    <Style x:Key="TesseraContentDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource TesseraRadius2xl}" />
        <Setter Property="Background" Value="{ThemeResource TesseraBgElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TesseraBorderSurfaceBrush}" />
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource TesseraPrimaryButtonStyle}" />
        <Setter Property="SecondaryButtonStyle" Value="{StaticResource TesseraSecondaryButtonStyle}" />
        <Setter Property="CloseButtonStyle" Value="{StaticResource TesseraSecondaryButtonStyle}" />
    </Style>

    <!-- ================= 卡片 Card / 列表项 ListItem ================= -->
    <Style x:Key="TesseraCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource TesseraBgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TesseraBorderSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource TesseraRadiusXl}" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <!-- 拼贴列表：ListView 的每一项是一块砖，砖缝 3；列表外层建议包一个 CornerRadius 18 的 Border -->
    <Style x:Key="TesseraListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Background" Value="{ThemeResource TesseraBgSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource TesseraRadiusGrout}" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- ================= 标签 Tag ================= -->
    <Style x:Key="TesseraTagStyle" TargetType="Border">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="{StaticResource TesseraRadiusSm}" />
        <Setter Property="Background" Value="{ThemeResource TesseraFillDefaultBrush}" />
    </Style>
    <Style x:Key="TesseraAccentTagStyle" TargetType="Border" BasedOn="{StaticResource TesseraTagStyle}">
        <Setter Property="Background" Value="{ThemeResource TesseraAccentSubtleBrush}" />
    </Style>
    <Style x:Key="TesseraSuccessTagStyle" TargetType="Border" BasedOn="{StaticResource TesseraTagStyle}">
        <Setter Property="Background" Value="{ThemeResource TesseraSuccessSubtleBrush}" />
    </Style>
    <Style x:Key="TesseraWarningTagStyle" TargetType="Border" BasedOn="{StaticResource TesseraTagStyle}">
        <Setter Property="Background" Value="{ThemeResource TesseraWarningSubtleBrush}" />
    </Style>
    <Style x:Key="TesseraDangerTagStyle" TargetType="Border" BasedOn="{StaticResource TesseraTagStyle}">
        <Setter Property="Background" Value="{ThemeResource TesseraDangerSubtleBrush}" />
    </Style>
    <Style x:Key="TesseraTagTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TesseraTextSecondaryBrush}" />
    </Style>

    <!-- ================= 徽标 Badge ================= -->
    <Style x:Key="TesseraBadgeStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{ThemeResource TesseraDangerSolidBrush}" />
    </Style>
    <Style x:Key="TesseraBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TesseraTextOnSolidBrush}" />
    </Style>

    <!-- ================= 头像 Avatar：36% 圆角的方砖，文字用软衬线 ================= -->
    <Style x:Key="TesseraAvatarStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{ThemeResource TesseraAccentSubtleBrush}" />
    </Style>
    <Style x:Key="TesseraAvatarTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TesseraDisplayFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TesseraAccentTextBrush}" />
    </Style>

    <!-- ================= 骨架屏 Skeleton ================= -->
    <Style x:Key="TesseraSkeletonStyle" TargetType="Border">
        <Setter Property="Height" Value="12" />
        <Setter Property="CornerRadius" Value="{StaticResource TesseraRadiusGrout}" />
        <Setter Property="Background" Value="{ThemeResource TesseraFillDefaultBrush}" />
    </Style>

    <!-- ================= 顶部导航栏 NavBar ================= -->
    <Style x:Key="TesseraNavBarStyle" TargetType="Grid">
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Background" Value="{ThemeResource TesseraBgCanvasBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TesseraBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
</ResourceDictionary>
