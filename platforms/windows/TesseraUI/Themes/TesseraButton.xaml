<!-- 按钮：圆角方砖（合并 TesseraShapeRound.xaml 后为胶囊）。底部 2px 砖厚（实色砖另有顶部釉光）；按下下沉 1px、砖厚变薄，松手弹回。依赖 TesseraTokens.xaml。 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TesseraButtonBaseStyle" TargetType="Button">
        <!-- BorderBrush 用作砖厚颜色 -->
        <Setter Property="BorderBrush" Value="{ThemeResource TesseraEdgeSoftBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="{StaticResource TesseraSizeMd}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="{ThemeResource TesseraRadiusMd}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource TesseraFocusRingBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource TesseraFocusRingThickness}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource TesseraFocusRingMargin}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="PressSink" />
                        </Grid.RenderTransform>
                        <Border x:Name="Background"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <!-- 砖厚与釉光：用和砖同样的圆角裁切 -->
                        <Border CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" Opacity="{ThemeResource TesseraTileEdgeOpacity}">
                            <Grid>
                                <Rectangle x:Name="Edge" Height="2" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}" />
                            </Grid>
                        </Border>
                        <Border x:Name="StateLayer" Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}"
                                          AutomationProperties.AccessibilityView="Raw" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <!-- 松手：近似 snappy 弹簧（0.3s，回弹 0.15） -->
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="TranslateY" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Height" To="2" Duration="0:0:0.3" EnableDependentAnimation="True" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateLayer.Background" Value="{ThemeResource TesseraStateHoverBrush}" />
                                    </VisualState.Setters>
                                    <!-- 在按钮上松手会从 Pressed 进入 PointerOver，这里同样要弹回 -->
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="TranslateY" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Height" To="2" Duration="0:0:0.3" EnableDependentAnimation="True" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="StateLayer.Background" Value="{ThemeResource TesseraStatePressedBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <!-- 拼贴：下沉 1px；圆融：缩小到 97%（数值来自 TesseraTokens / TesseraShapeRound） -->
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="TranslateY" To="{ThemeResource TesseraPressSinkY}" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="ScaleX" To="{ThemeResource TesseraPressScale}" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="ScaleY" To="{ThemeResource TesseraPressScale}" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Height" To="1" Duration="0:0:0.08" EnableDependentAnimation="True" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource TesseraDisabledOpacity}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 实色按钮：悬停叠白 8%，按下叠黑 8% -->
    <Style x:Key="TesseraSolidButtonBaseStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource TesseraFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="{StaticResource TesseraSizeMd}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="{ThemeResource TesseraRadiusMd}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource TesseraFocusRingBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource TesseraFocusRingThickness}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource TesseraFocusRingMargin}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="PressSink" />
                        </Grid.RenderTransform>
                        <Border x:Name="Background"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <!-- 砖厚与釉光：用和砖同样的圆角裁切 -->
                        <Border CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" Opacity="{ThemeResource TesseraTileEdgeOpacity}">
                            <Grid>
                                <Rectangle x:Name="Edge" Height="2" VerticalAlignment="Bottom" Fill="{ThemeResource TesseraEdgeSolidBrush}" />
                                <Rectangle Height="1" VerticalAlignment="Top" Fill="{ThemeResource TesseraSheenBrush}" />
                            </Grid>
                        </Border>
                        <!-- 圆融：整面柔光，顶部略亮、底部略暗，没有硬边 -->
                        <Border CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" Opacity="{ThemeResource TesseraRoundSheenOpacity}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#24FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                    <GradientStop Color="#00000000" Offset="0.55" />
                                    <GradientStop Color="#0F000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="StateLayer" Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}"
                                          AutomationProperties.AccessibilityView="Raw" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <!-- 松手：近似 snappy 弹簧（0.3s，回弹 0.15） -->
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="TranslateY" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Height" To="2" Duration="0:0:0.3" EnableDependentAnimation="True" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateLayer.Background" Value="{ThemeResource TesseraStateSolidHoverBrush}" />
                                    </VisualState.Setters>
                                    <!-- 在按钮上松手会从 Pressed 进入 PointerOver，这里同样要弹回 -->
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="TranslateY" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Height" To="2" Duration="0:0:0.3" EnableDependentAnimation="True" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="StateLayer.Background" Value="{ThemeResource TesseraStateSolidPressedBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <!-- 拼贴：下沉 1px；圆融：缩小到 97%（数值来自 TesseraTokens / TesseraShapeRound） -->
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="TranslateY" To="{ThemeResource TesseraPressSinkY}" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="ScaleX" To="{ThemeResource TesseraPressScale}" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PressSink" Storyboard.TargetProperty="ScaleY" To="{ThemeResource TesseraPressScale}" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Height" To="1" Duration="0:0:0.08" EnableDependentAnimation="True" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource TesseraDisabledOpacity}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TesseraPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TesseraSolidButtonBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource TesseraAccentSolidBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TesseraTextOnSolidBrush}" />
    </Style>
    <Style x:Key="TesseraSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TesseraButtonBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource TesseraFillDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TesseraTextPrimaryBrush}" />
    </Style>
    <!-- 文字按钮没有砖厚：模板里的砖厚取 BorderBrush，这里设为透明 -->
    <Style x:Key="TesseraTextButtonStyle" TargetType="Button" BasedOn="{StaticResource TesseraButtonBaseStyle}">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TesseraAccentTextBrush}" />
    </Style>
    <Style x:Key="TesseraDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource TesseraSolidButtonBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource TesseraDangerSolidBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TesseraTextOnSolidBrush}" />
    </Style>
</ResourceDictionary>
