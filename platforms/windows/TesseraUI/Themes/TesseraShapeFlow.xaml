<!-- TesseraUI v0.6.1 — 由 scripts/build.mjs 从 tokens/*.json 生成，请勿手改。 -->
<!-- 流韵外观：以圆融为基础（成组控件合成一整块、没有砖缝和分割线），圆角介于方砖与胶囊之间，按压时变成胶囊。
     流韵的水波、涟漪等动效在 WinUI 上逐步提供，见 README。
     用法：在 App.xaml 中紧跟 TesseraTokens.xaml、TesseraTheme.xaml 之后合并本文件（不要同时合并 TesseraShapeRound.xaml）。
     WinUI 会把超过半高的圆角自动收成半圆，所以 9999 就是胶囊。 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ThemeDictionaries 必须放在最前面 -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TesseraListItemBackgroundBrush" Color="Transparent" />
            <Thickness x:Key="TesseraSurfaceBorderThickness">0</Thickness>
            <Thickness x:Key="TesseraNavBarBorderThickness">0</Thickness>
            <SolidColorBrush x:Key="TesseraListContainerBrush" Color="#FFFBF9F5" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TesseraListItemBackgroundBrush" Color="Transparent" />
            <Thickness x:Key="TesseraSurfaceBorderThickness">0</Thickness>
            <Thickness x:Key="TesseraNavBarBorderThickness">0</Thickness>
            <SolidColorBrush x:Key="TesseraListContainerBrush" Color="#FF1E1C18" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="TesseraListItemBackgroundBrush" Color="Transparent" />
            <Thickness x:Key="TesseraSurfaceBorderThickness">1</Thickness>
            <Thickness x:Key="TesseraNavBarBorderThickness">0,0,0,1</Thickness>
            <SolidColorBrush x:Key="TesseraListContainerBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 成组控件内侧不留圆角、不留缝，合成一整块 -->
    <CornerRadius x:Key="TesseraRadiusGrout">0</CornerRadius>
    <x:Double x:Key="TesseraTileGrout">0</x:Double>
    <!-- 去掉砖厚 -->
    <x:Double x:Key="TesseraTileEdge">0</x:Double>
    <Thickness x:Key="TesseraTileEdgeThickness">0</Thickness>

    <CornerRadius x:Key="TesseraRadiusSm">9999</CornerRadius>
    <CornerRadius x:Key="TesseraRadiusMd">17</CornerRadius>
    <CornerRadius x:Key="TesseraRadiusLg">22</CornerRadius>
    <CornerRadius x:Key="TesseraRadiusXl">26</CornerRadius>
    <CornerRadius x:Key="TesseraRadius2xl">34</CornerRadius>
    <CornerRadius x:Key="TesseraRoundRow">18</CornerRadius>
    <CornerRadius x:Key="TesseraRoundPill">9999</CornerRadius>
    <x:Double x:Key="TesseraRoundGap">8</x:Double>
    <x:Double x:Key="TesseraRoundPressScale">0.97</x:Double>
    <!-- 标记：自定义控件据此切换到圆融外观 -->
    <x:String x:Key="TesseraShape">flow</x:String>

    <!-- 按压：轻捏，不下沉；去掉砖厚，实色控件加整面柔光 -->
    <x:Double x:Key="TesseraPressSinkY">0</x:Double>
    <x:Double x:Key="TesseraPressScale">0.96</x:Double>
    <x:Double x:Key="TesseraTileEdgeOpacity">0</x:Double>
    <x:Double x:Key="TesseraRoundSheenOpacity">1</x:Double>
    <CornerRadius x:Key="TesseraSwitchTrackRadius">15</CornerRadius>
    <CornerRadius x:Key="TesseraSwitchThumbRadius">12</CornerRadius>
    <CornerRadius x:Key="TesseraCheckboxRadius">8</CornerRadius>
    <CornerRadius x:Key="TesseraBadgeRadius">9</CornerRadius>
    <CornerRadius x:Key="TesseraAvatarRadius">20</CornerRadius>
    <CornerRadius x:Key="TesseraMenuItemRadius">16</CornerRadius>
    <CornerRadius x:Key="TesseraSkeletonRadius">9999</CornerRadius>
    <!-- 列表：整个列表是一整块圆角面，行与行之间没有缝 -->
    <CornerRadius x:Key="TesseraListContainerRadius">26</CornerRadius>
    <CornerRadius x:Key="TesseraListItemRadius">18</CornerRadius>
    <Thickness x:Key="TesseraListItemMargin">0</Thickness>
    <Thickness x:Key="TesseraListContainerPadding">6</Thickness>
    <!-- 没有描边和分割线：数值放在上面的主题字典里，高对比度主题下加回描边 -->

    <!-- 系统控件 -->
    <CornerRadius x:Key="ControlCornerRadius">17</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">22</CornerRadius>
</ResourceDictionary>
