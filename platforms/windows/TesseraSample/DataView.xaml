<UserControl
    x:Class="TesseraSample.DataView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tessera="using:TesseraUI">
    <!-- v0.6 数据展示组件，顺序与 Web / Android / Apple 一致 -->
    <StackPanel x:Name="Root" Spacing="20" Padding="20,4,20,32" MaxWidth="520" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource TesseraTitle2TextStyle}" Text="表格" />
        <TextBlock Style="{StaticResource TesseraCaptionTextStyle}" Foreground="{ThemeResource TesseraTextSecondaryBrush}" Text="宽屏：固定首列、可排序、多选、分页" />
        <tessera:TesseraTable x:Name="Orders" />
        <TextBlock Style="{StaticResource TesseraCaptionTextStyle}" Foreground="{ThemeResource TesseraTextSecondaryBrush}" Text="窄屏：每行一张卡片" />
        <tessera:TesseraTable x:Name="Cards" />
        <TextBlock Style="{StaticResource TesseraCaptionTextStyle}" Foreground="{ThemeResource TesseraTextSecondaryBrush}" Text="加载中 · 筛选后没有结果" />
        <tessera:TesseraTable x:Name="Skeleton" />
        <tessera:TesseraTable x:Name="Empty" />

        <TextBlock Style="{StaticResource TesseraTitle2TextStyle}" Text="树 · 折叠面板" />
        <TreeView x:Name="Files" ItemContainerStyle="{StaticResource TesseraTreeViewItemStyle}" AutomationProperties.Name="文件" SelectionMode="Single" />
        <tessera:TesseraAccordion x:Name="Faq" Single="True" />

        <TextBlock Style="{StaticResource TesseraTitle2TextStyle}" Text="描述列表 · 统计数字 · 时间线" TextWrapping="Wrap" />
        <tessera:TesseraDescriptionList x:Name="Details" />
        <tessera:TesseraStats x:Name="Stats" />
        <tessera:TesseraTimeline x:Name="Shipping" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Style="{StaticResource TesseraBodySmTextStyle}" Text="搜索" VerticalAlignment="Center" />
            <tessera:TesseraKbd Keys="Ctrl+K" />
            <TextBlock Style="{StaticResource TesseraBodySmTextStyle}" Text="保存" VerticalAlignment="Center" />
            <tessera:TesseraKbd Keys="Ctrl+S" />
        </StackPanel>

        <TextBlock Style="{StaticResource TesseraTitle2TextStyle}" Text="提示 · 气泡卡片 · 代码块" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Style="{StaticResource TesseraIconButtonStyle}" AutomationProperties.Name="复制链接">
                <ToolTipService.ToolTip><ToolTip Style="{StaticResource TesseraToolTipStyle}" Content="复制链接" /></ToolTipService.ToolTip>
                <tessera:TesseraIcon Icon="copy" Size="18" />
            </Button>
            <tessera:TesseraTooltipBubble Text="悬停或键盘聚焦时显示提示" VerticalAlignment="Center" />
        </StackPanel>
        <Button Style="{StaticResource TesseraSecondaryButtonStyle}" Content="配送说明">
            <Button.Flyout>
                <Flyout FlyoutPresenterStyle="{StaticResource TesseraFlyoutPresenterStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource TesseraTitle3TextStyle}" Text="配送说明" />
                        <TextBlock Style="{StaticResource TesseraBodySmTextStyle}" Foreground="{ThemeResource TesseraTextSecondaryBrush}" Text="江浙沪次日达，其他地区 2～3 天送达。" TextWrapping="Wrap" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
        <tessera:TesseraPopoverPanel x:Name="Popover" Title="配送说明" />
        <tessera:TesseraCodeBlock x:Name="Code" CodeLanguage="csharp" LineNumbers="True" />

        <TextBlock Style="{StaticResource TesseraTitle2TextStyle}" Text="轮播 · 图片预览" />
        <tessera:TesseraCarousel x:Name="Banners" PageHeight="180" />
        <Button x:Name="OpenViewer" Style="{StaticResource TesseraSecondaryButtonStyle}" Content="打开图片预览" />
        <tessera:TesseraImageViewer x:Name="Viewer" Height="300" CornerRadius="16" />

        <TextBlock Style="{StaticResource TesseraTitle2TextStyle}" Text="进度 · 加载 · 横幅" />
        <tessera:TesseraProgress x:Name="Upload" />
        <tessera:TesseraProgress x:Name="Done" Tone="success" />
        <tessera:TesseraProgress x:Name="Preparing" />
        <StackPanel Orientation="Horizontal" Spacing="20">
            <tessera:TesseraProgressRing x:Name="Storage" VerticalAlignment="Center" />
            <tessera:TesseraProgressRing x:Name="Goal" Size="96" />
            <tessera:TesseraSpinner VerticalAlignment="Center" />
            <tessera:TesseraSpinner Size="32" VerticalAlignment="Center" />
        </StackPanel>
        <tessera:TesseraBanner x:Name="Update" Title="更新可用" Text="新版本已发布，重启后生效。" Dismissible="True" />
        <tessera:TesseraBanner Tone="warning" Text="网络连接不稳定，部分内容可能无法加载。" />
        <tessera:TesseraBanner Tone="danger" Text="付款失败，请检查银行卡余额。" Dismissible="True" />

        <TextBlock Style="{StaticResource TesseraTitle2TextStyle}" Text="结果 · 空状态" />
        <tessera:TesseraResult x:Name="Paid" Status="success" Title="付款成功" Text="订单 A-1024 已支付，预计明天送达。" />
        <tessera:TesseraResult x:Name="Failed" Status="error" Title="提交失败" Text="网络中断，填写的内容已保存，请稍后重试。" />
        <tessera:TesseraResult Status="notfound" Title="页面不存在" Text="链接可能已失效。" />
        <tessera:TesseraEmptyState x:Name="NoFavorites" Title="还没有收藏" Text="看到喜欢的商品，点一下心形就能收藏在这里。" />
    </StackPanel>
</UserControl>
